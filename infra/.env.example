WAFLOW_VERSION=local
WAFLOW_HTTP_PORT=8080
APP_URL=http://localhost:8080
APP_KEY=

POSTGRES_DB=waflow
POSTGRES_USER=waflow
POSTGRES_PASSWORD=

OPENWA_MASTER_KEY=
BAILEYS_AUTH_ENCRYPTION_KEY=
OPENWA_WEBHOOK_SECRET=
INTER_WEBHOOK_SECRET=
OPENWA_PIDS_LIMIT=2048
OPENWA_MEM_LIMIT=2g

LOG_LEVEL=info

# Recorrência via Pix Automático do Banco Inter. Cartões exigem outro adquirente.
BILLING_DRIVER=inter
BILLING_CURRENCY=BRL
BILLING_CHECKOUT_TTL_MINUTES=30
BILLING_PAYMENT_METHODS=pix

# Crie a integração no Internet Banking PJ, baixe inter.crt/inter.key e coloque em infra/secrets/.
INTER_ENVIRONMENT=sandbox
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERTIFICATE_PATH=/run/secrets/inter.crt
INTER_PRIVATE_KEY_PATH=/run/secrets/inter.key
INTER_CERTIFICATE_PASSPHRASE=
INTER_PRIVATE_KEY_PASSPHRASE=
INTER_ACCOUNT=
INTER_WEBHOOK_URL=
INTER_RECEIVER_NAME=
INTER_RECEIVER_CNPJ=
INTER_RECEIVER_AGENCY=
INTER_RECEIVER_ACCOUNT=
INTER_RECEIVER_ACCOUNT_TYPE=CORRENTE

# Use an SMTP provider in production. The local default writes verification links to Laravel logs.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=no-reply@waflow.local
MAIL_FROM_NAME=Waflow
