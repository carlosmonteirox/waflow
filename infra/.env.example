WAFLOW_VERSION=local
WAFLOW_HTTP_PORT=8080
APP_URL=http://localhost:8080
APP_KEY=

POSTGRES_DB=waflow
POSTGRES_USER=waflow
POSTGRES_PASSWORD=

OPENWA_MASTER_KEY=
BAILEYS_AUTH_ENCRYPTION_KEY=
OPENWA_WEBHOOK_SECRET=
OPENWA_PIDS_LIMIT=2048
OPENWA_MEM_LIMIT=2g

LOG_LEVEL=info

# Provider adapter to be selected. Waflow never stores raw card data.
BILLING_DRIVER=pending
BILLING_CURRENCY=BRL
BILLING_CHECKOUT_TTL_MINUTES=30

# Use an SMTP provider in production. The local default writes verification links to Laravel logs.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=no-reply@waflow.local
MAIL_FROM_NAME=Waflow
