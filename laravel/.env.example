APP_NAME=Waflow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=waflow
DB_USERNAME=waflow
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=waflow

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENWA_URL=http://openwa:2785
OPENWA_API_KEY=
OPENWA_TIMEOUT=30
OPENWA_WEBHOOK_URL=http://gateway/api/v1/internal/openwa/events
OPENWA_WEBHOOK_SECRET=

WAFLOW_TRIAL_DAYS=7
WAFLOW_TRIAL_INSTANCE_LIMIT=1
WAFLOW_TRIAL_MESSAGE_LIMIT=500
WAFLOW_TRIAL_WEBHOOK_LIMIT=2
WAFLOW_TRIAL_API_KEY_LIMIT=1
WAFLOW_TRIAL_PORTAL_LIMIT=1
WAFLOW_TRIALS_PER_IP=2
WAFLOW_API_REQUESTS_PER_MINUTE=120
